# ── 必填 ──────────────────────────────────────────────────────────────
# SiliconFlow API key：对话（Qwen3-8B）+ 视觉（Qwen3-VL-8B-Instruct）
# + 意图路由（Qwen3-8B）+ 复杂查询拆解（DeepSeek-R1-0528-Qwen3-8B）
# + Embedding（Qwen3-Embedding-8B@1024）+ Rerank（bge-reranker-v2-m3）
SILICONFLOW_API_KEY=

# 启动强校验：拒绝默认值（空/占位符时进程直接退出）
JWT_SECRET=
PII_ENCRYPTION_KEY=

# ── 可选 ──────────────────────────────────────────────────────────────
# 备用对话 provider（chat_provider="minimax" 时使用）
# MINIMAX_API_KEY=

# ── 检索策略开关（RAG v2：默认全关，见 README「检索链路」表）────────────
# CROSS_DOC_ENABLED=false
# SECTION_BOOST_ENABLED=false
# SECTION_SUPPLEMENT_ENABLED=false
# YEAR_SUPPLEMENT_ENABLED=false
# QUERY_DECOMPOSITION_ENABLED=false
# EVIDENCE_GATE_ENABLED=false

# Question channel（多路召回，默认开；Baseline 评测在 OFF 下锁定）
# QUESTION_CHANNEL_ENABLED=true

# ── 运行调优 ──────────────────────────────────────────────────────────
# LOG_LEVEL=INFO                  # DEBUG 时输出检索链路诊断
# EMBEDDING_RATE_LIMIT_RPS=5      # SiliconFlow embedding 限速（429 时调低）
# DATABASE_URL=postgresql://ragent:ragent@localhost:5432/ragent
